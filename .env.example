# Kopieren nach .env und Werte anpassen. Die Datei .env niemals ins Repository einchecken.

# Langer Zufallswert, z. B. erzeugt mit: openssl rand -hex 32
REA_SECRET_KEY=bitte-aendern
REA_DB_PASSWORD=bitte-aendern

# Adresse(n), unter denen REA aufgerufen wird
REA_ALLOWED_HOSTS=192.168.2.68,localhost,127.0.0.1
REA_CSRF_TRUSTED_ORIGINS=https://192.168.2.68:8443,http://192.168.2.68:8100
REA_PORT=8100
# auf true setzen, sobald REA nur noch über HTTPS (Reverse Proxy) erreichbar ist
REA_SECURE_COOKIES=false

# Erster Benutzer (wird nur angelegt, wenn noch keiner existiert)
REA_ADMIN_USER=martin
REA_ADMIN_PASSWORD=bitte-aendern

# E-Mail-Versand über das eigene Postfach
REA_EMAIL_HOST=smtp.example.de
REA_EMAIL_PORT=587
REA_EMAIL_USER=rechnung@example.de
REA_EMAIL_PASSWORD=bitte-aendern
REA_EMAIL_TLS=true
REA_EMAIL_SSL=false
REA_EMAIL_FROM=rechnung@example.de
